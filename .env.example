# Optional: fine-grained GitHub Personal Access Token for private/authenticated account repos.
# Give only the permissions required: Metadata (read) for listing, Contents (read) for README.
# Never commit a real .env file or paste this token into chat/LLM prompts.
GITHUB_TOKEN=

# Optional local database location. Default: ./data/repoviva.db
# REPOVIVA_DB_PATH=data/repoviva.db
